{
  "version": 8,
  "cmakeMinimumRequired": { "major": 4, "minor": 4, "patch": 5 },
  "configurePresets": [
    {
      "name": "linux-ci",
      "displayName": "Linux native C++17 debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/linux-ci",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "SIR_BUILD_TESTS": "ON" }
    },
    {
      "name": "windows-ci",
      "displayName": "Windows native C++17 debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/windows-ci",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "SIR_BUILD_TESTS": "ON" }
    },
    {
      "name": "linux-release",
      "inherits": "linux-ci",
      "binaryDir": "${sourceDir}/out/linux-release",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "SIR_BUILD_TESTS": "ON" }
    },
    {
      "name": "windows-release",
      "inherits": "windows-ci",
      "binaryDir": "${sourceDir}/out/windows-release",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "SIR_BUILD_TESTS": "ON" }
    },
    {
      "name": "macos-preview",
      "inherits": "linux-ci",
      "displayName": "Experimental macOS native C++17 build",
      "binaryDir": "${sourceDir}/out/macos-preview"
    }
  ],
  "buildPresets": [
    { "name": "linux-ci", "configurePreset": "linux-ci" },
    { "name": "windows-ci", "configurePreset": "windows-ci" },
    { "name": "linux-release", "configurePreset": "linux-release" },
    { "name": "windows-release", "configurePreset": "windows-release" },
    { "name": "macos-preview", "configurePreset": "macos-preview" }
  ],
  "testPresets": [
    { "name": "linux-ci", "configurePreset": "linux-ci", "output": { "outputOnFailure": true } },
    { "name": "windows-ci", "configurePreset": "windows-ci", "output": { "outputOnFailure": true } },
    { "name": "linux-release", "configurePreset": "linux-release", "output": { "outputOnFailure": true } },
    { "name": "windows-release", "configurePreset": "windows-release", "output": { "outputOnFailure": true } },
    { "name": "macos-preview", "configurePreset": "macos-preview", "output": { "outputOnFailure": true } }
  ]
}
