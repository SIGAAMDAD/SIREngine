{
  "version": 8,
  "cmakeMinimumRequired": {
    "major": 4,
    "minor": 4,
    "patch": 5
  },
  "configurePresets": [
    {
      "name": "fast-base",
      "hidden": true,
      "generator": "FASTBuild",
      "binaryDir": "${sourceDir}/out/${hostSystemName}/${presetName}",
      "cacheVariables": {
        "CMAKE_CXX_STANDARD": "17",
        "CMAKE_FASTBUILD_CACHE_PATH": "${sourceDir}/.cache/fastbuild",
        "SIR_BUILD_TESTS": "ON",
        "SIR_ENABLE_UNITY": "OFF",
        "SIR_ENABLE_PCH": "OFF",
        "SIR_ENABLE_IPO": "OFF"
      }
    },
    {
      "name": "dev",
      "inherits": "fast-base",
      "displayName": "FASTBuild incremental developer",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "SIR_FAST_ITERATION": "ON"
      }
    },
    {
      "name": "debug",
      "inherits": "fast-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "profile",
      "inherits": "fast-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "release",
      "inherits": "fast-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "release-ipo",
      "inherits": "release",
      "cacheVariables": {
        "SIR_ENABLE_IPO": "ON"
      }
    },
    {
      "name": "bulk",
      "inherits": "release",
      "cacheVariables": {
        "SIR_ENABLE_UNITY": "ON"
      }
    },
    {
      "name": "asan",
      "inherits": "fast-base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "SIR_ENABLE_ASAN": "ON"
      }
    },
    {
      "name": "ubsan",
      "inherits": "fast-base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "SIR_ENABLE_UBSAN": "ON"
      }
    },
    {
      "name": "macos-preview",
      "inherits": "dev",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },
    {
      "name": "tooling",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/${hostSystemName}/tooling",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "SIR_FAST_ITERATION": "ON",
        "SIR_ENABLE_UNITY": "OFF",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "coverage-llvm23",
      "displayName": "Pinned LLVM 23 source coverage and full compiler inventory",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/${hostSystemName}/llvm23-qualification",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "clang++-23",
        "CMAKE_CXX_FLAGS": "-fprofile-instr-generate -fcoverage-mapping -fno-omit-frame-pointer",
        "CMAKE_EXE_LINKER_FLAGS": "-fprofile-instr-generate",
        "CMAKE_SHARED_LINKER_FLAGS": "-fprofile-instr-generate",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "SIR_BUILD_TESTS": "ON",
        "SIR_WITH_GOOGLETEST": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "dev",
      "configurePreset": "dev",
      "nativeToolOptions": [
        "-cache"
      ]
    },
    {
      "name": "debug",
      "configurePreset": "debug",
      "nativeToolOptions": [
        "-cache"
      ]
    },
    {
      "name": "profile",
      "configurePreset": "profile",
      "nativeToolOptions": [
        "-cache"
      ]
    },
    {
      "name": "release",
      "configurePreset": "release",
      "nativeToolOptions": [
        "-cache"
      ]
    },
    {
      "name": "release-ipo",
      "configurePreset": "release-ipo",
      "nativeToolOptions": [
        "-cache"
      ]
    },
    {
      "name": "bulk",
      "configurePreset": "bulk",
      "nativeToolOptions": [
        "-cache"
      ]
    },
    {
      "name": "asan",
      "configurePreset": "asan",
      "nativeToolOptions": [
        "-cache"
      ]
    },
    {
      "name": "ubsan",
      "configurePreset": "ubsan",
      "nativeToolOptions": [
        "-cache"
      ]
    },
    {
      "name": "macos-preview",
      "configurePreset": "macos-preview",
      "nativeToolOptions": [
        "-cache"
      ]
    },
    {
      "name": "tooling",
      "configurePreset": "tooling"
    },
    {
      "name": "coverage-llvm23",
      "configurePreset": "coverage-llvm23"
    }
  ],
  "testPresets": [
    {
      "name": "dev",
      "configurePreset": "dev",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "debug",
      "configurePreset": "debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "profile",
      "configurePreset": "profile",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "release",
      "configurePreset": "release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "release-ipo",
      "configurePreset": "release-ipo",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "bulk",
      "configurePreset": "bulk",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "asan",
      "configurePreset": "asan",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "ubsan",
      "configurePreset": "ubsan",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "macos-preview",
      "configurePreset": "macos-preview",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "tooling",
      "configurePreset": "tooling",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "pr-smoke",
      "configurePreset": "dev",
      "description": "Fast deterministic PR-bound tests",
      "filter": {
        "include": {
          "label": "^gate:pr$"
        }
      },
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "core-unit",
      "configurePreset": "dev",
      "description": "Core subsystem unit tests",
      "filter": {
        "include": {
          "name": "^core[.]",
          "label": "^kind:unit$"
        }
      },
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "integration",
      "configurePreset": "dev",
      "description": "Integrated native tests",
      "filter": {
        "include": {
          "label": "^kind:integration$"
        }
      },
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "nightly-regression",
      "configurePreset": "dev",
      "description": "Nightly repeat-regression selection",
      "filter": {
        "include": {
          "label": "^nightly:repeat$"
        }
      },
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "qualification",
      "configurePreset": "dev",
      "description": "Full qualified native test selection",
      "filter": {
        "include": {
          "label": "^gate:qualification$"
        }
      },
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "coverage-llvm23",
      "configurePreset": "coverage-llvm23",
      "filter": {
        "include": {
          "label": "^gate:qualification$"
        }
      },
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
