{
  "version": 8,
  "cmakeMinimumRequired": {
    "major": 4,
    "minor": 4,
    "patch": 5
  },
  "configurePresets": [
    {
      "name": "native-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/${hostSystemName}/${presetName}",
      "cacheVariables": {
        "SIR_BUILD_TESTS": "ON",
        "SIR_ENABLE_UNITY": "OFF",
        "SIR_ENABLE_PCH": "OFF",
        "SIR_ENABLE_IPO": "OFF",
        "SIR_CXX_STANDARD": "AUTO",
        "CMAKE_CXX_SCAN_FOR_MODULES": "OFF"
      }
    },
    {
      "name": "dev",
      "inherits": "native-base",
      "displayName": "Ninja incremental developer",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "SIR_FAST_ITERATION": "ON"
      }
    },
    {
      "name": "debug",
      "inherits": "native-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "profile",
      "inherits": "native-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "release",
      "inherits": "native-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "release-ipo",
      "inherits": "release",
      "cacheVariables": {
        "SIR_ENABLE_IPO": "ON"
      }
    },
    {
      "name": "bulk",
      "inherits": "release",
      "cacheVariables": {
        "SIR_ENABLE_UNITY": "ON"
      }
    },
    {
      "name": "asan",
      "inherits": "native-base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "SIR_ENABLE_ASAN": "ON"
      }
    },
    {
      "name": "ubsan",
      "inherits": "native-base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "SIR_ENABLE_UBSAN": "ON"
      }
    },
    {
      "name": "macos-preview",
      "inherits": "dev",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },
    {
      "name": "vs2022",
      "displayName": "Visual Studio 2022 x64 (out-of-source)",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/out/${hostSystemName}/${presetName}",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "SIR_BUILD_TESTS": "ON",
        "SIR_CXX_STANDARD": "AUTO"
      },
      "toolset": "v143"
    },
    {
      "name": "tooling",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/${hostSystemName}/tooling",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "SIR_FAST_ITERATION": "ON",
        "SIR_ENABLE_UNITY": "OFF",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "SIR_CXX_STANDARD": "AUTO"
      }
    },
    {
      "name": "coverage-llvm23",
      "displayName": "Pinned LLVM 23 source coverage and full compiler inventory",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/${hostSystemName}/llvm23-qualification",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "clang-23",
        "CMAKE_CXX_COMPILER": "clang++-23",
        "CMAKE_CXX_FLAGS": "-fprofile-instr-generate -fcoverage-mapping -fno-omit-frame-pointer",
        "CMAKE_EXE_LINKER_FLAGS": "-fprofile-instr-generate",
        "CMAKE_SHARED_LINKER_FLAGS": "-fprofile-instr-generate",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "SIR_BUILD_TESTS": "ON",
        "SIR_WITH_GOOGLETEST": "ON",
        "SIR_CXX_STANDARD": "AUTO"
      }
    },
    {
      "name": "tooling-cxx17",
      "displayName": "SIREngine C++17 compatibility qualification",
      "inherits": "tooling",
      "binaryDir": "${sourceDir}/out/${hostSystemName}/tooling-cxx17",
      "cacheVariables": {
        "SIR_CXX_STANDARD": "17"
      }
    },
    {
      "name": "standards-clang23",
      "displayName": "SIREngine Clang 23.1.5 standards qualification",
      "inherits": "tooling",
      "binaryDir": "${sourceDir}/out/${hostSystemName}/standards-clang23",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "SIR_CXX_STANDARD": "23",
        "SIR_STRICT_WARNINGS": "ON",
        "CMAKE_C_COMPILER": "clang-23",
        "CMAKE_CXX_COMPILER": "clang++-23",
        "CMAKE_CXX_SCAN_FOR_MODULES": "OFF",
        "SIR_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "standards-cxx17",
      "displayName": "SIREngine C++17 fallback standards qualification",
      "inherits": "tooling-cxx17",
      "binaryDir": "${sourceDir}/out/${hostSystemName}/standards-cxx17",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "SIR_CXX_STANDARD": "17",
        "SIR_STRICT_WARNINGS": "ON",
        "CMAKE_C_COMPILER": "clang-23",
        "CMAKE_CXX_COMPILER": "clang++-23",
        "CMAKE_CXX_SCAN_FOR_MODULES": "OFF",
        "SIR_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "linux-gcc",
      "inherits": "dev",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++"
      }
    },
    {
      "name": "linux-clang",
      "inherits": "dev",
      "toolchainFile": "${sourceDir}/Build/CMake/Toolchains/LinuxClang.cmake",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++"
      }
    },
    {
      "name": "windows-msvc",
      "inherits": "dev",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl"
      },
      "architecture": {
        "value": "x64",
        "strategy": "external"
      }
    },
    {
      "name": "windows-clang-cl",
      "inherits": "dev",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang-cl",
        "CMAKE_CXX_COMPILER": "clang-cl"
      },
      "architecture": {
        "value": "x64",
        "strategy": "external"
      }
    },
    {
      "name": "fastbuild-dev",
      "inherits": "dev",
      "displayName": "Optional FASTBuild developer",
      "generator": "FASTBuild",
      "cacheVariables": {
        "CMAKE_FASTBUILD_CACHE_PATH": "${sourceDir}/.cache/fastbuild"
      }
    }
  ],
