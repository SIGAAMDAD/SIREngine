// SHD-01: single descriptor contract for the shared terrain material/VT
// evaluator. These bindings are also frozen in
// rendering/rd/shaders/terrain_3d_rd_material_vt_contract.h.
// WORLD owns set 0 for geometry and uses set 1 for VT; clipmap uses set 0.
#define T3D_MATERIAL_VT_CONTRACT_VERSION 1u
#if defined(T3D_WORLD_RASTER_EMBEDDED)
#define T3D_TERRAIN_VT_DESCRIPTOR_SET 1
#define T3D_TERRAIN_VT_ALLOCATION_BINDING 1
#define T3D_TERRAIN_VT_PAGE_TABLE_BINDING 2
#define T3D_TERRAIN_VT_ALBEDO_BINDING 3
#define T3D_TERRAIN_VT_NORMAL_BINDING 4
#define T3D_TERRAIN_VT_SURFACE_BINDING 5
#define T3D_TERRAIN_VT_HEIGHT_BINDING 6
#define T3D_TERRAIN_VT_TAIL_METADATA_BINDING 7
#define T3D_TERRAIN_VT_ALBEDO_TAIL_BINDING 8
#define T3D_TERRAIN_VT_NORMAL_TAIL_BINDING 9
#define T3D_TERRAIN_VT_SURFACE_TAIL_BINDING 10
#define T3D_TERRAIN_VT_HEIGHT_TAIL_BINDING 11
#define T3D_TERRAIN_VT_MIP_LAYOUT_BINDING 12
#define T3D_TERRAIN_VT_HINT_BINDING 17
#define T3D_TERRAIN_VT_HEIGHT16_BINDING 18
#define T3D_TERRAIN_VT_HEIGHT16_TAIL_BINDING 19
#define T3D_CS_DESCRIPTOR_SET 1
#define T3D_CS_PAGE_TABLE_BINDING 13
#define T3D_CS_ALBEDO_BINDING 14
#define T3D_CS_NORMAL_BINDING 15
#define T3D_CS_SURFACE_BINDING 16
#else
#define T3D_TERRAIN_VT_DESCRIPTOR_SET 0
#define T3D_TERRAIN_VT_ALLOCATION_BINDING 26
#define T3D_TERRAIN_VT_PAGE_TABLE_BINDING 27
#define T3D_TERRAIN_VT_ALBEDO_BINDING 28
#define T3D_TERRAIN_VT_NORMAL_BINDING 29
#define T3D_TERRAIN_VT_SURFACE_BINDING 30
#define T3D_TERRAIN_VT_HEIGHT_BINDING 31
#define T3D_TERRAIN_VT_TAIL_METADATA_BINDING 32
#define T3D_TERRAIN_VT_ALBEDO_TAIL_BINDING 33
#define T3D_TERRAIN_VT_NORMAL_TAIL_BINDING 34
#define T3D_TERRAIN_VT_SURFACE_TAIL_BINDING 35
#define T3D_TERRAIN_VT_HEIGHT_TAIL_BINDING 36
#define T3D_TERRAIN_VT_MIP_LAYOUT_BINDING 37
