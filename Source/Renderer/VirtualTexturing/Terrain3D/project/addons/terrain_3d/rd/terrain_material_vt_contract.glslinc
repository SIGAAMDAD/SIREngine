#define T3D_TERRAIN_VT_HEIGHT16_BINDING 44
#define T3D_TERRAIN_VT_HEIGHT16_TAIL_BINDING 45
#define T3D_CS_DESCRIPTOR_SET 0
#define T3D_CS_PAGE_TABLE_BINDING 39
#define T3D_CS_ALBEDO_BINDING 40
#define T3D_CS_NORMAL_BINDING 41
#define T3D_CS_SURFACE_BINDING 42
#endif

// SHD-02: shipping terrain shares the adaptive-control and prepared-mip
// evaluator across color, feedback, compact, one-sun and depth variants.
// Alternate material modes continue to be resolved from authored tier data.
// Hint-buffer presence changes the descriptor ABI, not the material algorithm.
#if !defined(T3D_WORLD_RASTER_EMBEDDED) && !defined(T3D_UCMP_EDITOR)
#ifndef T3D_CONTROL_FILTER_CLASS
#define T3D_CONTROL_FILTER_CLASS 3
#endif
#ifndef T3D_CONTROL_ACTIVE_CORNER_FETCH
#define T3D_CONTROL_ACTIVE_CORNER_FETCH 1
#endif
#ifndef T3D_PREPARED_MIP_BIAS
#define T3D_PREPARED_MIP_BIAS 1
#endif
#endif

// One resident-page and tail fallback contract for near/middle/far and WORLD.
// The shader-root's native/compact/feedback pass defines determine I/O and
// legal resource declarations; material and VT evaluation are shared.
// SHD-02 will integrate the current control-adaptive and hint/bias trials.
bool t3d_vt_resolve_page_core(
uint allocationId, uint requestedPage, uint requestedMip, uint allocationCount, uint pageCount, out T3DVTResolveResult result);
bool t3d_vt_resolve_page_core_loaded(
uint allocationId, uint requestedPage, uint requestedMip, uint allocationCount, uint pageCount,
T3DVTAllocation allocation, out T3DVTResolveResult result);

#endif
