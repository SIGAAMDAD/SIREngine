# The fixture tool emits real material IR HLSL, not handwritten stand-ins.
foreach(SIR_REQUIRED SIR_EMITTER_FIXTURE SIR_DXC SIR_SPIRV_VAL SIR_SPIRV_DIS SIR_OUTPUT_DIR)
    if(NOT DEFINED ${SIR_REQUIRED} OR "${${SIR_REQUIRED}}" STREQUAL "")
        message(FATAL_ERROR "Missing ${SIR_REQUIRED} for material IR native DXC validation")
    endif()
endforeach()
file(MAKE_DIRECTORY "${SIR_OUTPUT_DIR}")
execute_process(COMMAND "${SIR_EMITTER_FIXTURE}" "${SIR_OUTPUT_DIR}"
    RESULT_VARIABLE SIR_FIXTURE_RESULT ERROR_VARIABLE SIR_FIXTURE_ERROR)
if(NOT SIR_FIXTURE_RESULT EQUAL 0)
    message(FATAL_ERROR "Material IR HLSL fixture generation failed: ${SIR_FIXTURE_ERROR}")
endif()

foreach(SIR_VARIANT switch-off switch-on texture)
    set(SIR_SOURCE "${SIR_OUTPUT_DIR}/${SIR_VARIANT}.hlsl")
    if(NOT EXISTS "${SIR_SOURCE}")
        message(FATAL_ERROR "Material IR emitter did not produce ${SIR_SOURCE}")
    endif()
    file(READ "${SIR_SOURCE}" SIR_HLSL)
    if(NOT SIR_HLSL MATCHES "sirEvaluateMaterialPass1" OR NOT SIR_HLSL MATCHES "SV_Target0")
        message(FATAL_ERROR "Material IR emitter produced an incomplete ${SIR_VARIANT} shader")
    endif()
    if(SIR_VARIANT STREQUAL "texture" AND NOT SIR_HLSL MATCHES "SampleLevel")
        message(FATAL_ERROR "Material IR texture emitter dropped explicit sample lowering")
    endif()
    foreach(SIR_BACKEND dxil spirv)
        set(SIR_FIRST "${SIR_OUTPUT_DIR}/${SIR_VARIANT}-${SIR_BACKEND}-first.bin")
        set(SIR_SECOND "${SIR_OUTPUT_DIR}/${SIR_VARIANT}-${SIR_BACKEND}-second.bin")
        foreach(SIR_BINARY "${SIR_FIRST}" "${SIR_SECOND}")
            set(SIR_ARGS -nologo -HV 2021 -O3 -T ps_6_6 -E main -Fo "${SIR_BINARY}")
            if(SIR_BACKEND STREQUAL "spirv")
                list(APPEND SIR_ARGS -spirv -fspv-target-env=vulkan1.3)
            endif()
            list(APPEND SIR_ARGS "${SIR_SOURCE}")
            execute_process(COMMAND "${SIR_DXC}" ${SIR_ARGS}
                RESULT_VARIABLE SIR_COMPILER_RESULT ERROR_VARIABLE SIR_COMPILER_ERROR)
            if(NOT SIR_COMPILER_RESULT EQUAL 0)
                message(FATAL_ERROR "DXC ${SIR_VARIANT}/${SIR_BACKEND} failed: ${SIR_COMPILER_ERROR}")
            endif()
        endforeach()
        file(SHA256 "${SIR_FIRST}" SIR_FIRST_HASH)
        file(SHA256 "${SIR_SECOND}" SIR_SECOND_HASH)
        if(NOT SIR_FIRST_HASH STREQUAL SIR_SECOND_HASH)
            message(FATAL_ERROR "Material IR ${SIR_VARIANT}/${SIR_BACKEND} output is nondeterministic")
        endif()
        if(SIR_BACKEND STREQUAL "spirv")
            execute_process(COMMAND "${SIR_SPIRV_VAL}" --target-env vulkan1.3 "${SIR_FIRST}"
                RESULT_VARIABLE SIR_VALID_RESULT ERROR_VARIABLE SIR_VALID_ERROR)
            if(NOT SIR_VALID_RESULT EQUAL 0)
                message(FATAL_ERROR "Material IR SPIR-V validation failed: ${SIR_VALID_ERROR}")
            endif()
            execute_process(COMMAND "${SIR_SPIRV_DIS}" "${SIR_FIRST}" -o -
                RESULT_VARIABLE SIR_REFLECT_RESULT OUTPUT_VARIABLE SIR_REFLECTION ERROR_VARIABLE SIR_REFLECT_ERROR)
            if(NOT SIR_REFLECT_RESULT EQUAL 0 OR NOT SIR_REFLECTION MATCHES "OpEntryPoint Fragment")
                message(FATAL_ERROR "Material IR SPIR-V entry point missing: ${SIR_REFLECT_ERROR}")
            endif()
        else()
            execute_process(COMMAND "${SIR_DXC}" -dumpbin "${SIR_FIRST}"
                RESULT_VARIABLE SIR_REFLECT_RESULT OUTPUT_VARIABLE SIR_REFLECTION ERROR_VARIABLE SIR_REFLECT_ERROR)
            if(NOT SIR_REFLECT_RESULT EQUAL 0 OR NOT SIR_REFLECTION MATCHES "Resource Bindings")
                message(FATAL_ERROR "Material IR DXIL reflection unavailable: ${SIR_REFLECT_ERROR}")
            endif()
        endif()
        if(NOT SIR_REFLECTION MATCHES "MaterialParams")
            message(FATAL_ERROR "Material IR ${SIR_VARIANT}/${SIR_BACKEND} lost MaterialParams resource")
        endif()
        if(SIR_VARIANT STREQUAL "texture" AND
           (NOT SIR_REFLECTION MATCHES "AlbedoTexture" OR NOT SIR_REFLECTION MATCHES "LinearSampler"))
            message(FATAL_ERROR "Material IR ${SIR_BACKEND} texture/sampler reflection mismatch")
        endif()
    endforeach()
endforeach()
message(STATUS "Material IR emitted DXIL/SPIR-V binaries, reflection and determinism validated")
