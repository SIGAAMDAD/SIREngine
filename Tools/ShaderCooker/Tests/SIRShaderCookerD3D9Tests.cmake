file(MAKE_DIRECTORY "${SIR_OUTPUT_DIR}")
set(SIR_BIN "${SIR_OUTPUT_DIR}/d3d9.bin")
function(sir_expect_d3d9 nExpected nStage nModel)
    execute_process(COMMAND "${SIR_COOKER}" --root "${SIR_FIXTURES}"
        --source valid.hlsl --entry main --backend d3d9 --stage "${nStage}"
        --shader-model "${nModel}" --compiler "${SIR_MOCK_COMPILER}"
        --output "${SIR_BIN}" ${ARGN}
        RESULT_VARIABLE SIR_RESULT ERROR_VARIABLE SIR_DIAGNOSTIC)
    if(NOT SIR_RESULT EQUAL nExpected)
        message(FATAL_ERROR "D3D9 ${nStage} SM${nModel}: expected ${nExpected}, got ${SIR_RESULT}: ${SIR_DIAGNOSTIC}")
    endif()
    if(nExpected EQUAL 0)
        file(READ "${SIR_BIN}.manifest" SIR_MANIFEST)
        if(NOT SIR_MANIFEST MATCHES "BINARY_FORMAT=D3D9_TOKENS")
            message(FATAL_ERROR "D3D9 manifest missing binary token identity")
        endif()
    elseif(EXISTS "${SIR_BIN}" OR EXISTS "${SIR_BIN}.manifest")
        message(FATAL_ERROR "Rejected D3D9 shader left stale artifacts")
    endif()
endfunction()
foreach(SIR_MODEL 2 3)
    foreach(SIR_STAGE vertex fragment)
        sir_expect_d3d9(0 "${SIR_STAGE}" "${SIR_MODEL}")
        sir_expect_d3d9(7 "${SIR_STAGE}" "${SIR_MODEL}" --define WRONG_VERSION=1)
        sir_expect_d3d9(7 "${SIR_STAGE}" "${SIR_MODEL}" --define CORRUPT=1)
        sir_expect_d3d9(6 "${SIR_STAGE}" "${SIR_MODEL}" --define FAIL=1)
    endforeach()
endforeach()
sir_expect_d3d9(4 compute 3)
sir_expect_d3d9(2 vertex 4)
