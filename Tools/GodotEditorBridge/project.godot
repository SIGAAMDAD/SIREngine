; Reference project for the editor-only SIREngine dock integration.
; Open with the supplied Godot 4.8 fork in editor mode.
config_version=5

[application]
config/name="SIREngine Editor Bridge"
run/main_scene="res://Scenes/BridgeSmoke.tscn"

[editor_plugins]
enabled=PackedStringArray("res://addons/sir_editor_bridge/plugin.cfg")
