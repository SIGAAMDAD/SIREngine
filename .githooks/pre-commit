#!/bin/sh
# Git for Windows invokes POSIX hooks through its bundled shell.
set -eu
if command -v python3 >/dev/null 2>&1; then
    exec python3 Tools/Standards/pre_commit.py
elif command -v python >/dev/null 2>&1; then
    exec python Tools/Standards/pre_commit.py
elif command -v py >/dev/null 2>&1; then
    exec py -3 Tools/Standards/pre_commit.py
else
    echo "SIREngine standards: Python 3 is required" >&2
    exit 2
fi
