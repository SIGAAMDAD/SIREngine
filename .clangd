# SIREngine clangd workspace policy (LLVM/clangd 18 and newer).
# VS Code uses the published root compile_commands.json.
# For other editors: cmake --preset linux-gcc (or linux-clang/windows-msvc),
# then cmake --build --preset linux-gcc --target sir-clangd-db.
# Compilation flags are taken from the real CMake database. Never force -std,
# -target, GCC include paths, or Clang driver mode: MSVC/clang-cl and Linux
# Clang/GCC builds each need their own authentic flags.
# Publish again after changing presets so clangd uses the selected compiler.
Index:
  Background: Build
  StandardLibrary: true

Style:
  # Do not suggest "using std::..." or "using eastl::..." code actions.
  FullyQualifiedNamespaces: [std, eastl]

Diagnostics:
  # Keep all compiler diagnostics. .clang-tidy is the single check registry.
  ClangTidy:
    FastCheckFilter: Loose
  UnusedIncludes: Strict
  # Detect direct dependency omissions (first-party headers should be standalone).
  Includes:
    # Every first-party header explicitly includes this engine PCH by policy.
    IgnoreHeader: ['(^|/)Core/SIRPCH\.h$']

Completion:
  AllScopes: true

InlayHints:
  Enabled: true
  ParameterNames: true
  DeducedTypes: true
  Designators: true
  BlockEnd: false
  TypeNameLimit: 40

Hover:
  ShowAKA: true

---
# Do not index or run first-party style checks on vendored/generated sources.
If:
  PathMatch: '(^|.*/)(ThirdParty|External|Vendor|out|build)/.*'
Index:
  Background: Skip
Diagnostics:
  ClangTidy:
    Remove: '*'
  UnusedIncludes: None
  MissingIncludes: None
