root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = tab
indent_size = 4

[*.{md,yml,yaml,json,cmake,py}]
indent_style = space
indent_size = 4

[*.{yml,yaml}]
indent_size = 2

[CMakeLists.txt]
indent_style = space
indent_size = 4

[*.bat]
end_of_line = crlf
