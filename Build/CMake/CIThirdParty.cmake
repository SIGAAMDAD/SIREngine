cmake_minimum_required(VERSION 3.25)
get_filename_component(SIR_ROOT "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
find_package(Git REQUIRED)
set(sirLockPath "${SIR_ROOT}/ThirdParty/IMPORT_LOCK.json")
if(NOT EXISTS "${sirLockPath}")
    message(FATAL_ERROR "Missing pinned third-party dependency lock: ${sirLockPath}")
endif()
file(READ "${sirLockPath}" sirLock)
string(JSON sirCount ERROR_VARIABLE sirJsonError LENGTH "${sirLock}" entries)
if(sirJsonError OR NOT sirCount EQUAL 44)
    message(FATAL_ERROR "Expected exactly 44 imported dependency pins; found ${sirCount}: ${sirJsonError}")
endif()

set(sirKnownPaths
    ThirdParty/EASTL
    ThirdParty/EABase
    ThirdParty/EAAssert
    ThirdParty/OpenALSoft
    ThirdParty/meshoptimizer)
set(sirExpectedPaths ${sirKnownPaths})
math(EXPR sirLast "${sirCount} - 1")
foreach(sirIndex RANGE 0 ${sirLast})
    string(JSON sirPath GET "${sirLock}" entries ${sirIndex} path)
    string(JSON sirUrl GET "${sirLock}" entries ${sirIndex} url)
    string(JSON sirSha GET "${sirLock}" entries ${sirIndex} sha)
    if(NOT sirPath MATCHES "^ThirdParty/[A-Za-z0-9._-]+$")
        message(FATAL_ERROR "Invalid third-party path at entry ${sirIndex}: ${sirPath}")
    endif()
    string(LENGTH "${sirSha}" sirShaLength)
    if(NOT sirShaLength EQUAL 40 OR NOT sirSha MATCHES "^[0-9a-f]+$")
        message(FATAL_ERROR "Invalid Git SHA at ${sirPath}: ${sirSha}")
    endif()
    if(sirPath IN_LIST sirExpectedPaths)
        message(FATAL_ERROR "Duplicate or pre-existing dependency in import lock: ${sirPath}")
    endif()
    list(APPEND sirExpectedPaths "${sirPath}")
    execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${SIR_ROOT}" ls-files --stage -- "${sirPath}"
        RESULT_VARIABLE sirStatus OUTPUT_VARIABLE sirStage OUTPUT_STRIP_TRAILING_WHITESPACE)
    set(sirExpectedStage "160000 ${sirSha} 0\t${sirPath}")
    if(NOT sirStatus EQUAL 0 OR NOT sirStage STREQUAL sirExpectedStage)
        message(FATAL_ERROR "Gitlink missing or mismatched for ${sirPath}: ${sirStage}")
    endif()
    execute_process(COMMAND "${GIT_EXECUTABLE}" config -f "${SIR_ROOT}/.gitmodules" --get "submodule.${sirPath}.url"
        RESULT_VARIABLE sirStatus OUTPUT_VARIABLE sirActualUrl OUTPUT_STRIP_TRAILING_WHITESPACE)
    if(NOT sirStatus EQUAL 0 OR NOT sirActualUrl STREQUAL sirUrl)
        message(FATAL_ERROR "Git submodule URL mismatch for ${sirPath}: ${sirActualUrl}")
    endif()
endforeach()
foreach(sirPath IN LISTS sirKnownPaths)
    execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${SIR_ROOT}" ls-files --stage -- "${sirPath}"
        RESULT_VARIABLE sirStatus OUTPUT_VARIABLE sirStage OUTPUT_STRIP_TRAILING_WHITESPACE)
    if(NOT sirStatus EQUAL 0 OR NOT sirStage MATCHES "^160000 [0-9a-f]+ 0[\t ]+")
        message(FATAL_ERROR "Existing dependency missing Gitlink: ${sirPath}")
    endif()
    execute_process(COMMAND "${GIT_EXECUTABLE}" config -f "${SIR_ROOT}/.gitmodules" --get "submodule.${sirPath}.url"
        RESULT_VARIABLE sirStatus OUTPUT_VARIABLE sirUrl OUTPUT_STRIP_TRAILING_WHITESPACE)
    if(NOT sirStatus EQUAL 0 OR NOT sirUrl MATCHES "^https://github.com/")
        message(FATAL_ERROR "Existing dependency lacks a valid Git URL: ${sirPath}")
    endif()
endforeach()
execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${SIR_ROOT}" ls-files --stage -- ThirdParty
    RESULT_VARIABLE sirStatus OUTPUT_VARIABLE sirTracked)
if(NOT sirStatus EQUAL 0)
    message(FATAL_ERROR "Could not list third-party Git index")
endif()
string(REPLACE "\n" ";" sirTracked "${sirTracked}")
set(sirGitlinks 0)
foreach(sirLine IN LISTS sirTracked)
    if(sirLine MATCHES "^160000 ")
        string(REGEX REPLACE "^160000 [0-9a-f]+ 0[\t ]+" "" sirPath "${sirLine}")
        if(NOT sirPath IN_LIST sirExpectedPaths)
            message(FATAL_ERROR "Unregistered third-party Gitlink: ${sirPath}")
        endif()
        math(EXPR sirGitlinks "${sirGitlinks} + 1")
    endif()
endforeach()
if(NOT sirGitlinks EQUAL 49)
    message(FATAL_ERROR "Expected 49 third-party Gitlinks; found ${sirGitlinks}")
endif()
message(STATUS "PASS: ${sirGitlinks} third-party Gitlinks, including 44 pinned imported sources")
