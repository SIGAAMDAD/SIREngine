cmake_minimum_required(VERSION 3.25)
get_filename_component(SIR_ROOT "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
find_package(Git REQUIRED)
find_program(SIR_CLANG_FORMAT NAMES clang-format clang-format-22 REQUIRED)
execute_process(COMMAND "${SIR_CLANG_FORMAT}" --version OUTPUT_VARIABLE sirVersion
    RESULT_VARIABLE sirStatus OUTPUT_STRIP_TRAILING_WHITESPACE)
if(NOT sirStatus EQUAL 0 OR NOT sirVersion MATCHES "22\\.1\\.5")
    message(FATAL_ERROR "Expected clang-format 22.1.5; got: ${sirVersion}")
endif()
execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${SIR_ROOT}" ls-files --
    Engine/Source Tests Modules Tools
    OUTPUT_VARIABLE sirPaths RESULT_VARIABLE sirStatus)
if(NOT sirStatus EQUAL 0)
    message(FATAL_ERROR "Cannot discover C++ source")
endif()
string(REPLACE "\r" "" sirPaths "${sirPaths}")
string(REPLACE "\n" ";" sirPaths "${sirPaths}")
set(sirCount 0)
foreach(sirPath IN LISTS sirPaths)
    if(NOT sirPath MATCHES "\\.(cpp|cc|c|h|hpp)$")
        continue()
    endif()
    math(EXPR sirCount "${sirCount} + 1")
    execute_process(COMMAND "${SIR_CLANG_FORMAT}" --dry-run --Werror "${SIR_ROOT}/${sirPath}"
        RESULT_VARIABLE sirStatus)
    if(NOT sirStatus EQUAL 0)
        message(FATAL_ERROR "Formatting error: ${sirPath}")
    endif()
endforeach()
if(sirCount EQUAL 0)
    message(FATAL_ERROR "No SIREngine C++ sources found")
endif()
message(STATUS "PASS: ${sirCount} C++ files checked with ${sirVersion}")
