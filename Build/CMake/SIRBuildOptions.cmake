include_guard(GLOBAL)

option(SIR_FAST_ITERATION "Optimize native edit-build-test latency" OFF)
option(SIR_ENABLE_UNITY "Use unity groups for SIREngine-owned source" OFF)
option(SIR_ENABLE_PCH "Enable optional SIREngine-owned PCH" OFF)
option(SIR_ENABLE_IPO "Enable interprocedural optimization" OFF)
option(SIR_ENABLE_ASAN "Enable AddressSanitizer" OFF)
option(SIR_ENABLE_UBSAN "Enable UndefinedBehaviorSanitizer" OFF)
option(SIR_TRACE_COMPILATION "Enable Clang compilation traces" OFF)
set(SIR_UNITY_BATCH_SIZE 8 CACHE STRING "Files in a unity batch")

if(SIR_FAST_ITERATION AND SIR_ENABLE_IPO)
    message(FATAL_ERROR "Cannot combine fast iteration and IPO")
endif()
if((SIR_ENABLE_ASAN OR SIR_ENABLE_UBSAN) AND SIR_ENABLE_IPO)
    message(FATAL_ERROR "Cannot combine sanitizers and IPO")
endif()
if(SIR_ENABLE_UBSAN AND MSVC)
    message(FATAL_ERROR "UBSan is unsupported with MSVC")
endif()
if(SIR_TRACE_COMPILATION AND NOT CMAKE_CXX_COMPILER_ID MATCHES "Clang")
    message(FATAL_ERROR "Compilation tracing requires Clang")
endif()
if(NOT SIR_UNITY_BATCH_SIZE MATCHES "^[1-9][0-9]*$")
    message(FATAL_ERROR "SIR_UNITY_BATCH_SIZE must be positive")
endif()

function(sir_configure_owned_target sirTarget)
    if(SIR_ENABLE_UNITY)
        set_target_properties(${sirTarget} PROPERTIES UNITY_BUILD ON
            UNITY_BUILD_BATCH_SIZE "${SIR_UNITY_BATCH_SIZE}")
    endif()
    if(SIR_ENABLE_PCH)
        target_precompile_headers(${sirTarget} PRIVATE
            "${PROJECT_SOURCE_DIR}/Build/CMake/SIRPCH.hpp")
    endif()
    if(SIR_ENABLE_IPO)
        set_property(TARGET ${sirTarget} PROPERTY INTERPROCEDURAL_OPTIMIZATION TRUE)
    endif()
    if(SIR_FAST_ITERATION)
        if(MSVC)
            target_compile_options(${sirTarget} PRIVATE /Od /Z7)
        else()
            target_compile_options(${sirTarget} PRIVATE -O0 -g1)
        endif()
    endif()
    if(SIR_ENABLE_ASAN)
        if(MSVC)
            target_compile_options(${sirTarget} PRIVATE /fsanitize=address)
        else()
            target_compile_options(${sirTarget} PRIVATE -fsanitize=address -fno-omit-frame-pointer)
            target_link_options(${sirTarget} PRIVATE -fsanitize=address)
        endif()
    endif()
    if(SIR_ENABLE_UBSAN)
        target_compile_options(${sirTarget} PRIVATE -fsanitize=undefined -fno-omit-frame-pointer)
        target_link_options(${sirTarget} PRIVATE -fsanitize=undefined)
    endif()
    if(SIR_TRACE_COMPILATION)
        target_compile_options(${sirTarget} PRIVATE -ftime-trace)
    endif()
endfunction()
