# SIREngine-owned source convention gate. Structural checks complement
# clang-format; deeper symbol/ABI checks require a Clang AST build.
cmake_minimum_required(VERSION 3.25)
get_filename_component(SIR_ROOT "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
find_package(Git REQUIRED)
execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${SIR_ROOT}" ls-files --
    Source Tests
    RESULT_VARIABLE sirStatus OUTPUT_VARIABLE sirPaths)
if(NOT sirStatus EQUAL 0)
    message(FATAL_ERROR "Cannot inspect owned C++ source paths")
endif()
string(REPLACE "\r" "" sirPaths "${sirPaths}")
string(REPLACE "\n" ";" sirPaths "${sirPaths}")
set(sirChecked 0)
foreach(sirPath IN LISTS sirPaths)
    if(NOT sirPath MATCHES "\\.(cpp|cc|h|hpp)$")
        continue()
    endif()
    file(READ "${SIR_ROOT}/${sirPath}" sirText)
    if(sirText MATCHES "namespace[ \t\r\n]+[A-Za-z_][A-Za-z_0-9]*[ \t\r\n]*\\{")
        message(FATAL_ERROR "SIREngine-owned namespace declaration: ${sirPath}")
    endif()
    if(sirText MATCHES "enum[ \t\r\n]+class")
        message(FATAL_ERROR "Noncanonical owned enum class: ${sirPath}")
    endif()
    if(sirPath MATCHES "^Source/.*\\.h$")
        if(NOT sirText MATCHES "SIREngine MPLv2 Source Code")
            message(FATAL_ERROR "Missing MPLv2 owned header notice: ${sirPath}")
        endif()
        if(NOT sirText MATCHES "#ifndef __SIRENGINE_[A-Z0-9_]+_H__")
            message(FATAL_ERROR "Missing canonical header guard: ${sirPath}")
        endif()
        if(NOT sirText MATCHES "#include <SIRPCH.hpp>")
            message(FATAL_ERROR "Missing engine-wide PCH include: ${sirPath}")
        endif()
    endif()
    math(EXPR sirChecked "${sirChecked} + 1")
endforeach()
if(sirChecked EQUAL 0)
    message(FATAL_ERROR "No owned source files checked")
endif()
message(STATUS "PASS: ${sirChecked} owned C++ files passed structural checks")
