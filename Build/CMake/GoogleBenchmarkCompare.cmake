cmake_minimum_required(VERSION 3.25)
foreach(sirRequired SIR_CURRENT_DIR SIR_BASELINE_DIR SIR_REPORT)
    if(NOT DEFINED ${sirRequired})
        message(FATAL_ERROR "Missing benchmark comparison input: ${sirRequired}")
    endif()
endforeach()
file(GLOB sirCurrent "${SIR_CURRENT_DIR}/*.json")
list(SORT sirCurrent)
set(sirSummary "## Google Benchmark CPU profiling\n\n")
string(APPEND sirSummary "The CPU-time results use Google Benchmark's median of five runs. GitHub-hosted runner timing differences are observational, not a calibrated performance threshold.\n\n")
string(APPEND sirSummary "| Configuration | Benchmark | CPU time | Previous CPU time | Unit |\n| --- | --- | ---: | ---: | --- |\n")
set(sirCompared 0)
foreach(sirFile IN LISTS sirCurrent)
    get_filename_component(sirLabel "${sirFile}" NAME_WE)
    file(READ "${sirFile}" sirNewJson)
    string(JSON sirNewLength ERROR_VARIABLE sirJsonError LENGTH "${sirNewJson}" benchmarks)
    if(sirJsonError)
        message(FATAL_ERROR "Invalid Google Benchmark JSON: ${sirFile}")
    endif()

    set(sirOldFile "${SIR_BASELINE_DIR}/benchmarks/${sirLabel}.json")
    set(sirOldJson "")
    set(sirOldLength 0)
    if(EXISTS "${sirOldFile}")
        file(READ "${sirOldFile}" sirOldJson)
        string(JSON sirOldLength ERROR_VARIABLE sirJsonError LENGTH "${sirOldJson}" benchmarks)
        if(sirJsonError)
            message(FATAL_ERROR "Invalid baseline Google Benchmark JSON: ${sirOldFile}")
        endif()
    endif()

    if(sirNewLength EQUAL 0)
        message(WARNING "No measurements in ${sirFile}")
        continue()
    endif()
    math(EXPR sirLast "${sirNewLength} - 1")
    foreach(sirIndex RANGE 0 ${sirLast})
        string(JSON sirName GET "${sirNewJson}" benchmarks ${sirIndex} name)
        string(JSON sirCpu GET "${sirNewJson}" benchmarks ${sirIndex} cpu_time)
        string(JSON sirUnit GET "${sirNewJson}" benchmarks ${sirIndex} time_unit)
        string(JSON sirAggregate ERROR_VARIABLE sirAggregateError GET "${sirNewJson}" benchmarks ${sirIndex} aggregate_name)
        if(NOT sirAggregateError AND NOT sirAggregate STREQUAL "median")
            continue()
        endif()
        if(sirAggregateError AND sirName MATCHES "_(mean|median|stddev|cv)$")
            continue()
        endif()

        set(sirPrevious "—")
        if(sirOldLength GREATER 0)
            math(EXPR sirOldLast "${sirOldLength} - 1")
            foreach(sirOldIndex RANGE 0 ${sirOldLast})
                string(JSON sirOldName GET "${sirOldJson}" benchmarks ${sirOldIndex} name)
                if(sirOldName STREQUAL sirName)
                    string(JSON sirPrevious GET "${sirOldJson}" benchmarks ${sirOldIndex} cpu_time)
                    math(EXPR sirCompared "${sirCompared} + 1")
                    break()
                endif()
            endforeach()
        endif()
        string(APPEND sirSummary "| ${sirLabel} | ${sirName} | ${sirCpu} | ${sirPrevious} | ${sirUnit} |\n")
    endforeach()
endforeach()
if(NOT sirCurrent)
    string(APPEND sirSummary "| No benchmark artifacts | — | — | — | — |\n")
endif()
string(APPEND sirSummary "\nMatched measurements against previous successful nightly: ${sirCompared}.\n")
get_filename_component(sirOutputParent "${SIR_REPORT}" DIRECTORY)
file(MAKE_DIRECTORY "${sirOutputParent}")
file(WRITE "${SIR_REPORT}" "${sirSummary}")
message(STATUS "Compared ${sirCompared} Google Benchmark measurements")
