cmake_minimum_required(VERSION 3.25)
foreach(sirRequired SIR_CURRENT_DIR SIR_BASELINE_DIR SIR_REPORT)
    if(NOT DEFINED ${sirRequired})
        message(FATAL_ERROR "Missing nightly comparison input: ${sirRequired}")
    endif()
endforeach()
file(GLOB sirCurrent "${SIR_CURRENT_DIR}/*.json")
list(SORT sirCurrent)
if(NOT sirCurrent)
    message(FATAL_ERROR "No nightly compilation metrics were downloaded")
endif()
set(sirSummary "# SIREngine nightly compilation regressions\n\n")
string(TIMESTAMP sirDate "%Y-%m-%d %H:%M UTC" UTC)
string(APPEND sirSummary "Generated ${sirDate}. Build time is wall-clock time and may vary with runner and compiler-cache conditions.\n\n")
string(APPEND sirSummary "| Configuration | Result | Build seconds (delta) | Binary bytes (delta) | Tests | Compiler warnings |\n")
string(APPEND sirSummary "| --- | --- | ---: | ---: | ---: | ---: |\n")
set(sirFailures 0)
set(sirCompared 0)
set(sirNotes "")
foreach(sirFile IN LISTS sirCurrent)
    get_filename_component(sirFileName "${sirFile}" NAME)
    file(READ "${sirFile}" sirNew)
    foreach(sirKey label result build_seconds binary_bytes tests warnings)
        string(JSON sirNew_${sirKey} ERROR_VARIABLE sirJsonError GET "${sirNew}" ${sirKey})
        if(sirJsonError)
            message(FATAL_ERROR "Invalid metrics ${sirFileName}: ${sirKey} ${sirJsonError}")
        endif()
    endforeach()

    set(sirDuration "${sirNew_build_seconds}")
    set(sirBytes "${sirNew_binary_bytes}")
    set(sirTests "${sirNew_tests}")
    set(sirWarnings "${sirNew_warnings}")
    set(sirOldPath "${SIR_BASELINE_DIR}/current/${sirFileName}")
    if(EXISTS "${sirOldPath}")
        file(READ "${sirOldPath}" sirOld)
        foreach(sirKey build_seconds binary_bytes tests warnings)
            string(JSON sirOld_${sirKey} ERROR_VARIABLE sirJsonError GET "${sirOld}" ${sirKey})
            if(sirJsonError)
                message(FATAL_ERROR "Invalid baseline ${sirFileName}: ${sirKey}")
            endif()
        endforeach()
        math(EXPR sirBuildDelta "${sirNew_build_seconds} - ${sirOld_build_seconds}")
        math(EXPR sirBinaryDelta "${sirNew_binary_bytes} - ${sirOld_binary_bytes}")
        set(sirDuration "${sirNew_build_seconds} (${sirBuildDelta})")
        set(sirBytes "${sirNew_binary_bytes} (${sirBinaryDelta})")
        if(sirNew_tests LESS sirOld_tests)
            set(sirTests "${sirNew_tests} (was ${sirOld_tests})")
            string(APPEND sirNotes "- **Test-count regression**: ${sirNew_label} dropped from ${sirOld_tests} to ${sirNew_tests} tests.\n")
            message(WARNING "Test-count regression on ${sirNew_label}")
        endif()
        if(sirNew_warnings GREATER sirOld_warnings)
            set(sirWarnings "${sirNew_warnings} (was ${sirOld_warnings})")
            string(APPEND sirNotes "- **New compiler warnings**: ${sirNew_label}, ${sirOld_warnings} to ${sirNew_warnings}.\n")
            message(WARNING "Compiler warnings increased on ${sirNew_label}: ${sirOld_warnings} -> ${sirNew_warnings}")
        endif()
        if(sirOld_build_seconds GREATER 0 AND sirBuildDelta GREATER 15)
            math(EXPR sirPercent "(100 * ${sirBuildDelta}) / ${sirOld_build_seconds}")
            if(sirPercent GREATER 30)
                message(WARNING "Compilation time increased ${sirPercent}% on ${sirNew_label}; inspect cache/runner conditions")
            endif()
        endif()
        math(EXPR sirCompared "${sirCompared} + 1")
    endif()
    if(NOT sirNew_result STREQUAL "pass")
        math(EXPR sirFailures "${sirFailures} + 1")
    endif()
    string(APPEND sirSummary "| ${sirNew_label} | ${sirNew_result} | ${sirDuration} | ${sirBytes} | ${sirTests} | ${sirWarnings} |\n")
endforeach()
string(APPEND sirSummary "\n**Compared configurations:** ${sirCompared}; **failed configurations:** ${sirFailures}.\n")
if(sirNotes)
    string(APPEND sirSummary "\n## Detected changes\n\n${sirNotes}")
endif()
if(sirCompared EQUAL 0)
    string(APPEND sirSummary "\nNo compatible previous nightly artifact was available. This run establishes the first baseline.\n")
endif()
get_filename_component(sirOutDir "${SIR_REPORT}" DIRECTORY)
file(MAKE_DIRECTORY "${sirOutDir}")
file(WRITE "${SIR_REPORT}" "${sirSummary}")
message(STATUS "Wrote nightly regression comparison for ${sirCompared} configurations; ${sirFailures} failed")
