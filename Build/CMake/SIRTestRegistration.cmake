include_guard(GLOBAL)

set(SIR_KNOWN_TEST_KINDS unit integration functional stress soak fuzz benchmark)

function(sir_classify_tests sirDirectory)
    get_property(sirTests DIRECTORY "${sirDirectory}" PROPERTY TESTS)
    string(TOLOWER "${CMAKE_SYSTEM_NAME}" sirPlatform)

    foreach(sirTest IN LISTS sirTests)
        get_property(sirKnown GLOBAL PROPERTY SIR_CLASSIFIED_CTEST_NAMES)
        if(sirTest IN_LIST sirKnown)
            message(FATAL_ERROR "Duplicate registered CTest name: ${sirTest}")
        endif()
        list(APPEND sirKnown "${sirTest}")
        set_property(GLOBAL PROPERTY SIR_CLASSIFIED_CTEST_NAMES "${sirKnown}")

        get_property(sirLabels TEST "${sirTest}" DIRECTORY "${sirDirectory}" PROPERTY LABELS)
        get_property(sirTimeout TEST "${sirTest}" DIRECTORY "${sirDirectory}" PROPERTY TIMEOUT)
        string(REPLACE "." ";" sirParts "${sirTest}")
        list(GET sirParts 0 sirSubsystem)
        set(sirKind "")
        foreach(sirLabel IN LISTS sirLabels)
            if(sirLabel MATCHES "^kind:")
                if(NOT sirKind STREQUAL "" AND NOT sirLabel STREQUAL "kind:${sirKind}")
                    message(FATAL_ERROR "Conflicting CTest kind labels for ${sirTest}: ${sirLabels}")
                endif()
                string(SUBSTRING "${sirLabel}" 5 -1 sirKind)
            endif()
        endforeach()
        if(sirKind STREQUAL "")
            if(sirTest MATCHES "(^|[.])(soak)([.]|$)")
                set(sirKind soak)
            elseif(sirTest MATCHES "(^|[.])(stress|experiments|queue-candidates)([.]|$)")
                set(sirKind stress)
            elseif(sirTest MATCHES "(^|[.])(benchmark|profiling)([.]|$)")
                set(sirKind benchmark)
            elseif(sirTest MATCHES "(^|[.])(integration|lifecycle)([.]|$)")
                set(sirKind integration)
            else()
                set(sirKind unit)
            endif()
        endif()
        if(NOT sirKind IN_LIST SIR_KNOWN_TEST_KINDS)
            message(FATAL_ERROR "Unsupported CTest kind for ${sirTest}: ${sirKind}")
        endif()

        set(sirResource cpu)
        if(sirTest MATCHES "^(render[.]vulkan[.]|renderer[.](opengl46|d3d12)[.])")
            set(sirResource gpu)
        endif()
        list(APPEND sirLabels "subsystem:${sirSubsystem}" "kind:${sirKind}"
            "platform:${sirPlatform}" "resource:${sirResource}"
            "gate:main" "gate:nightly" "gate:qualification")
        if(sirTest MATCHES "^(core[.]jobs[.]|core[.]memory[.](allocators|manager)|core[.]platform[.](io[.]regression|filesystem|input[.]stress|decommit-failure)|resources[.](integration[.]stress|streaming[.]native-file-io)|terrain[.])")
            list(APPEND sirLabels "nightly:repeat")
        endif()
        if(sirKind STREQUAL "unit" OR sirKind STREQUAL "integration" OR sirKind STREQUAL "functional")
            list(APPEND sirLabels "gate:pr")
        else()
            list(REMOVE_ITEM sirLabels "gate:pr")
        endif()
        if(NOT sirTimeout)
            set_tests_properties("${sirTest}" DIRECTORY "${sirDirectory}" PROPERTIES TIMEOUT 60)
        endif()
        if(sirResource STREQUAL gpu)
            set_tests_properties("${sirTest}" DIRECTORY "${sirDirectory}" PROPERTIES RESOURCE_LOCK "sir-gpu")
        endif()
        list(REMOVE_DUPLICATES sirLabels)
        set_tests_properties("${sirTest}" DIRECTORY "${sirDirectory}" PROPERTIES LABELS "${sirLabels}")
    endforeach()
    get_property(sirSubdirectories DIRECTORY "${sirDirectory}" PROPERTY SUBDIRECTORIES)
    foreach(sirSubdirectory IN LISTS sirSubdirectories)
        sir_classify_tests("${sirSubdirectory}")
    endforeach()
endfunction()
