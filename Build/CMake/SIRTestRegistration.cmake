include_guard(GLOBAL)

# CTest labels are CMake declarations, not generated validation JSON.
function(sir_classify_tests sirDirectory)
    get_property(sirTests DIRECTORY "${sirDirectory}" PROPERTY TESTS)
    if(NOT sirTests)
        message(FATAL_ERROR "No CTests registered in ${sirDirectory}")
    endif()
    foreach(sirTest IN LISTS sirTests)
        get_property(sirLabels TEST "${sirTest}" DIRECTORY "${sirDirectory}" PROPERTY LABELS)
        get_property(sirTimeout TEST "${sirTest}" DIRECTORY "${sirDirectory}" PROPERTY TIMEOUT)
        if(NOT sirTimeout)
            set_tests_properties("${sirTest}" DIRECTORY "${sirDirectory}" PROPERTIES TIMEOUT 60)
        endif()
        string(REPLACE "." ";" sirParts "${sirTest}")
        list(GET sirParts 0 sirSubsystem)
        list(APPEND sirLabels "subsystem:${sirSubsystem}" "gate:main" "gate:nightly" "gate:qualification")
        if(sirTest MATCHES "(^|[.])(soak)([.]|$)")
            list(APPEND sirLabels "kind:soak")
        elseif(sirTest MATCHES "(^|[.])(stress|experiments|queue-candidates)([.]|$)")
            list(APPEND sirLabels "kind:stress")
        elseif(sirTest MATCHES "(^|[.])(benchmark|profiling)([.]|$)")
            list(APPEND sirLabels "kind:benchmark")
        elseif(sirTest MATCHES "(^|[.])(integration|lifecycle)([.]|$)")
            list(APPEND sirLabels "kind:integration")
        else()
            list(APPEND sirLabels "kind:unit")
        endif()
        if(sirTest MATCHES "^(core[.]jobs[.]|core[.]memory[.](allocators|manager)|core[.]platform[.](io[.]regression|filesystem|input[.]stress|decommit-failure)|resources[.](integration[.]stress|streaming[.]native-file-io)|terrain[.])")
            list(APPEND sirLabels "nightly:repeat")
        endif()
        if(NOT sirTest MATCHES "(^|[.])(soak|stress|experiments|queue-candidates|benchmark|profiling)([.]|$)")
            list(APPEND sirLabels "gate:pr")
        endif()
        list(REMOVE_DUPLICATES sirLabels)
        set_tests_properties("${sirTest}" DIRECTORY "${sirDirectory}" PROPERTIES LABELS "${sirLabels}")
    endforeach()
    list(LENGTH sirTests sirCount)
    message(STATUS "Classified ${sirCount} CTests in ${sirDirectory}")
endfunction()
