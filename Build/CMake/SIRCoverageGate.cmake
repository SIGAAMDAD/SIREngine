cmake_minimum_required(VERSION 3.25)

# Gate an instrumented, source-scoped LLVM coverage export. The caller owns
# compilation and profile collection; missing/empty coverage is not a pass.
if(NOT DEFINED SIR_COVERAGE_JSON OR NOT EXISTS "${SIR_COVERAGE_JSON}")
    message(FATAL_ERROR "Set SIR_COVERAGE_JSON to an existing llvm-cov export JSON file")
endif()
if(NOT DEFINED SIR_COVERAGE_MINIMUM)
    set(SIR_COVERAGE_MINIMUM 90)
endif()
if(NOT "${SIR_COVERAGE_MINIMUM}" MATCHES "^[0-9]+$")
    message(FATAL_ERROR "SIR_COVERAGE_MINIMUM must be an integer percent")
endif()
if(SIR_COVERAGE_MINIMUM LESS 90 OR SIR_COVERAGE_MINIMUM GREATER 100)
    message(FATAL_ERROR "SIR_COVERAGE_MINIMUM must be between the current 90% floor and 100%")
endif()

file(READ "${SIR_COVERAGE_JSON}" sirCoverageJson)
string(JSON sirCoverageType ERROR_VARIABLE sirError GET "${sirCoverageJson}" type)
if(NOT sirError STREQUAL "NOTFOUND" OR NOT sirCoverageType STREQUAL "llvm.coverage.json.export")
    message(FATAL_ERROR "Expected llvm-cov export -format=text JSON, not a report or other JSON")
endif()
string(JSON sirDataCount ERROR_VARIABLE sirError LENGTH "${sirCoverageJson}" data)
if(NOT sirError STREQUAL "NOTFOUND" OR NOT sirDataCount EQUAL 1)
    message(FATAL_ERROR "Expected exactly one LLVM coverage data export")
endif()

string(JSON sirSourceCount ERROR_VARIABLE sirError LENGTH "${sirCoverageJson}" data 0 files)
if(NOT sirError STREQUAL "NOTFOUND" OR sirSourceCount LESS 1)
    message(FATAL_ERROR "Coverage export has no compiled source-file mappings")
endif()
if(DEFINED SIR_COVERAGE_REQUIRED_SOURCE)
    set(sirFoundRequired FALSE)
    math(EXPR sirLastSource "${sirSourceCount} - 1")
    foreach(iSource RANGE 0 ${sirLastSource})
        string(JSON sirSourceName ERROR_VARIABLE sirError GET "${sirCoverageJson}" data 0 files ${iSource} filename)
        if(NOT sirError STREQUAL "NOTFOUND")
            message(FATAL_ERROR "Coverage export has a missing filename")
        endif()
        string(FIND "${sirSourceName}" "${SIR_COVERAGE_REQUIRED_SOURCE}" sirFoundIndex)
        if(NOT sirFoundIndex EQUAL -1)
            set(sirFoundRequired TRUE)
        endif()
    endforeach()
    if(NOT sirFoundRequired)
        message(FATAL_ERROR "Missing required compiled source: ${SIR_COVERAGE_REQUIRED_SOURCE}")
    endif()
endif()

foreach(sirMetric IN ITEMS lines branches functions regions)
    string(JSON sirCovered ERROR_VARIABLE sirError GET "${sirCoverageJson}" data 0 totals ${sirMetric} covered)
    if(NOT sirError STREQUAL "NOTFOUND")
        message(FATAL_ERROR "Missing LLVM ${sirMetric} covered count: ${sirError}")
    endif()
    string(JSON sirTotal ERROR_VARIABLE sirError GET "${sirCoverageJson}" data 0 totals ${sirMetric} count)
    if(NOT sirError STREQUAL "NOTFOUND" OR sirTotal LESS 1)
        message(FATAL_ERROR "Missing or empty LLVM ${sirMetric} denominator")
    endif()
    math(EXPR sirScaledCovered "${sirCovered} * 100")
    math(EXPR sirRequired "${sirTotal} * ${SIR_COVERAGE_MINIMUM}")
    if(sirScaledCovered LESS sirRequired)
        message(FATAL_ERROR "LLVM ${sirMetric}: ${sirCovered}/${sirTotal} falls below ${SIR_COVERAGE_MINIMUM}%")
    endif()
    message(STATUS "LLVM ${sirMetric}: ${sirCovered}/${sirTotal} satisfies ${SIR_COVERAGE_MINIMUM}%")
endforeach()
message(STATUS "PASS: interim source-scoped LLVM coverage requirement")
