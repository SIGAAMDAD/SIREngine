{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CMake: build selected preset",
      "type": "cmake",
      "command": "build",
      "group": {"kind": "build", "isDefault": true},
      "problemMatcher": []
    },
    {
      "label": "CMake: test selected build",
      "type": "process",
      "command": "ctest",
      "args": ["--test-dir", "${command:cmake.buildDirectory}", "-C", "${command:cmake.buildType}", "--output-on-failure"],
      "dependsOn": "CMake: build selected preset",
      "group": "test",
      "problemMatcher": []
    }
  ]
}
