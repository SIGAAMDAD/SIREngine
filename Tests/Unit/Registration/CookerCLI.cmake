if(NOT DEFINED SIR_COOKER OR NOT DEFINED SIR_FIXTURES OR NOT DEFINED SIR_OUT)
    message(FATAL_ERROR "Missing cooker executable, fixtures or output directory")
endif()
file(MAKE_DIRECTORY "${SIR_OUT}")
foreach(sirVersion IN ITEMS A B)
    execute_process(COMMAND "${SIR_COOKER}" "${SIR_FIXTURES}/Manifest${sirVersion}.txt"
            "${SIR_OUT}/${sirVersion}.sirs" "${SIR_OUT}/${sirVersion}.sirc"
        RESULT_VARIABLE sirResult OUTPUT_VARIABLE sirStdout ERROR_VARIABLE sirStderr)
    if(NOT sirResult EQUAL 0)
        message(FATAL_ERROR "Cook ${sirVersion} failed: ${sirStderr}")
    endif()
endforeach()
foreach(sirExt IN ITEMS sirs sirc)
    file(SHA256 "${SIR_OUT}/A.${sirExt}" sirShaA)
    file(SHA256 "${SIR_OUT}/B.${sirExt}" sirShaB)
    if(NOT sirShaA STREQUAL sirShaB)
        message(FATAL_ERROR "Cooked ${sirExt} differs under input reorder")
    endif()
endforeach()
execute_process(COMMAND "${SIR_COOKER}" "${SIR_FIXTURES}/ManifestBad.txt"
        "${SIR_OUT}/bad.sirs" "${SIR_OUT}/bad.sirc" RESULT_VARIABLE sirBadResult)
if(sirBadResult EQUAL 0)
    message(FATAL_ERROR "Malformed duplicate manifest was admitted")
endif()
