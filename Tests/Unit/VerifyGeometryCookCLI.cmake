if(NOT DEFINED SIR_GEOMETRY_COOKER OR NOT DEFINED SIR_GEOMETRY_INPUT OR NOT DEFINED SIR_GEOMETRY_OUTPUT)
    message(FATAL_ERROR "Missing geometry fixture test arguments")
endif()
execute_process(COMMAND "${SIR_GEOMETRY_COOKER}" "${SIR_GEOMETRY_INPUT}" "${SIR_GEOMETRY_OUTPUT}" 123 8 72
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(SIR_GEOMETRY_EXPECT_FAILURE)
    if(result EQUAL 0)
        message(FATAL_ERROR "Degenerate geometry was accepted: ${output}")
    endif()
    return()
endif()
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Geometry cooker failed (${result}): ${error}")
endif()
if(NOT EXISTS "${SIR_GEOMETRY_OUTPUT}.sirm" OR NOT EXISTS "${SIR_GEOMETRY_OUTPUT}.sirp")
    message(FATAL_ERROR "Missing geometry cooker outputs")
endif()
file(SHA256 "${SIR_GEOMETRY_OUTPUT}.sirm" firstCatalog)
file(SHA256 "${SIR_GEOMETRY_OUTPUT}.sirp" firstShard)
execute_process(COMMAND "${SIR_GEOMETRY_COOKER}" "${SIR_GEOMETRY_INPUT}" "${SIR_GEOMETRY_OUTPUT}" 123 8 72
    RESULT_VARIABLE secondResult OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT secondResult EQUAL 0)
    message(FATAL_ERROR "Repeated geometry cook failed: ${error}")
endif()
file(SHA256 "${SIR_GEOMETRY_OUTPUT}.sirm" secondCatalog)
file(SHA256 "${SIR_GEOMETRY_OUTPUT}.sirp" secondShard)
if(NOT firstCatalog STREQUAL secondCatalog OR NOT firstShard STREQUAL secondShard)
    message(FATAL_ERROR "Geometry outputs differ between identical cooks")
endif()
