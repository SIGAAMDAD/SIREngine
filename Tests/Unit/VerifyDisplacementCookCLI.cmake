# Executed against the actual linked production offline cooker executable.
if(NOT DEFINED SIR_GEOMETRY_COOKER OR NOT EXISTS "${SIR_GEOMETRY_COOKER}")
    message(FATAL_ERROR "Geometry cooker executable missing")
endif()
set(work "${CMAKE_CURRENT_BINARY_DIR}/displacement-cli")
file(MAKE_DIRECTORY "${work}")
set(image "${work}/height.pgm")
file(COPY_FILE "${SIR_DISPLACEMENT_IMAGE}" "${image}")
set(a "${work}/a")
set(b "${work}/b")
set(c "${work}/changed")
foreach(out IN ITEMS "${a}" "${b}")
    execute_process(COMMAND "${SIR_GEOMETRY_COOKER}" "${SIR_DISPLACEMENT_OBJ}" "${out}" 991 7 103
        --heightmap "${image}" --amplitude 0.1 --midpoint 0 --error 0.02 --depth 6 --sampler clamp
        RESULT_VARIABLE rc OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr)
    if(NOT rc EQUAL 0)
        message(FATAL_ERROR "Displacement CLI failed: ${rc} ${stdout} ${stderr}")
    endif()
    foreach(ext IN ITEMS sirp sirm meshrecipe)
        if(NOT EXISTS "${out}.${ext}")
            message(FATAL_ERROR "Missing ${ext} output")
        endif()
    endforeach()
endforeach()
foreach(ext IN ITEMS sirp sirm)
    file(SHA256 "${a}.${ext}" sha1)
    file(SHA256 "${b}.${ext}" sha2)
    if(NOT sha1 STREQUAL sha2)
        message(FATAL_ERROR "Displacement package bytes are nondeterministic (${ext})")
    endif()
endforeach()
# Prevent package promotion with an existing recovery backup. The prior
# valid catalog/shard must remain byte-for-byte unchanged.
file(SHA256 "${a}.sirm" beforeCatalog)
file(SHA256 "${a}.sirp" beforeShard)
file(WRITE "${a}.sirp.bak" "incomplete-prior-recovery")
execute_process(COMMAND "${SIR_GEOMETRY_COOKER}" "${SIR_DISPLACEMENT_OBJ}" "${a}" 991 7 103
    --heightmap "${image}" --amplitude 0.3 --midpoint 0 --error 0.02 --depth 6 --sampler clamp
    RESULT_VARIABLE blockedRC OUTPUT_VARIABLE blockedOut ERROR_VARIABLE blockedError)
if(blockedRC EQUAL 0)
    message(FATAL_ERROR "Exporter overwrote a package with pending recovery backup")
endif()
file(REMOVE "${a}.sirp.bak")
file(SHA256 "${a}.sirm" afterCatalog)
file(SHA256 "${a}.sirp" afterShard)
if(NOT beforeCatalog STREQUAL afterCatalog OR NOT beforeShard STREQUAL afterShard)
    message(FATAL_ERROR "Rejected export corrupted a previously published package")
endif()
file(READ "${a}.meshrecipe" sidecar)
if(NOT sidecar MATCHES "SIR-DISPLACEMENT-RECIPE-V1" OR NOT sidecar MATCHES "sha256=[a-f0-9]{64}")
    message(FATAL_ERROR "Authoring recipe sidecar incomplete")
endif()
file(READ "${image}" imageText)
string(REPLACE "0 255 0" "0 127 0" changedText "${imageText}")
if(changedText STREQUAL imageText)
    message(FATAL_ERROR "Fixture mutation did not change source heightmap")
endif()
file(WRITE "${image}" "${changedText}")
execute_process(COMMAND "${SIR_GEOMETRY_COOKER}" "${SIR_DISPLACEMENT_OBJ}" "${c}" 991 7 103
    --heightmap "${image}" --amplitude 0.1 --midpoint 0 --error 0.02 --depth 6 --sampler clamp
    RESULT_VARIABLE changedRC OUTPUT_VARIABLE changedOut ERROR_VARIABLE changedError)
if(NOT changedRC EQUAL 0)
    message(FATAL_ERROR "Mutated heightmap cook failed: ${changedRC} ${changedError}")
endif()
file(SHA256 "${a}.sirm" originalCatalog)
file(SHA256 "${c}.sirm" changedCatalog)
if(originalCatalog STREQUAL changedCatalog)
    message(FATAL_ERROR "Heightmap mutation failed to invalidate source revision")
endif()
# Source removed after cooking: immutable runtime inputs remain intact.
file(REMOVE "${image}")
foreach(ext IN ITEMS sirp sirm)
    if(NOT EXISTS "${a}.${ext}")
        message(FATAL_ERROR "Runtime file disappeared with source heightmap")
    endif()
    file(READ "${a}.${ext}" bytes HEX)
    string(HEX "${SIR_DISPLACEMENT_IMAGE}" sourcePathHex)
    string(FIND "${bytes}" "${sourcePathHex}" found)
    if(NOT found EQUAL -1)
        message(FATAL_ERROR "Source image path leaked into runtime ${ext}")
    endif()
endforeach()
